# Copier vers .env (jamais commité) et compléter le mot de passe.

# "supabase" = base de l'équipe, "local" = données nycflights13 embarquées (hors-ligne).
DATA_SOURCE=supabase

# Supabase : bouton Connect > "Session pooler".
# Ne pas utiliser db.<ref>.supabase.co : connexion directe en IPv6 uniquement sur l'offre gratuite.
SUPABASE_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
# Via le pooler, l'utilisateur est <rôle>.<project-ref>. L'app utilise le rôle en lecture seule shiny_reader.
SUPABASE_USER=shiny_reader.olqkxvifgalmtooaetwt
SUPABASE_PASSWORD=
SUPABASE_SCHEMA=public

# Mettre à true pour relire la base au lieu du cache app/cache/ (puis remettre à false).
REFRESH_CACHE=false
